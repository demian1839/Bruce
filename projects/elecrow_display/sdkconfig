# Target Configuration for Elecrow Display Terminal (ESP32 / ESP32-S3)
CONFIG_IDF_TARGET="esp32s3"

# Flash Size & Custom 4MB Partition Configuration (Supports large ~2.1MB - 3.6MB app binaries)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

# FreeRTOS Tick Rate (1000 Hz for sub-10ms response)
CONFIG_FREERTOS_HZ=1000

# ESP-NOW / Wi-Fi Stack Configurations
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENHANCED_LIGHT_SLEEP=n
